<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <div class="back-links">
      <a href="/tips" class="back-link">← 목록으로</a>
    </div>

    <%
      const catColor = {
        "직업공략": "#8fc7e8",
        "생활팁": "#f29ca0",
        "어비스": "#f6c26b",
        "레이드": "#c9c2ea",
        "악보공유": "#8ed1a6",
      };
    %>

    <section class="panel detail-panel">
      <div class="detail-head">
        <span class="badge-cat-solid" style="background-color:<%= catColor[tip.category] || '#c9c2ea' %>"><%= tip.category %></span>

        <div class="detail-title-row">
          <h2 class="detail-title"><%= tip.title %></h2>
          <% if (currentUser) { %>
            <div class="detail-actions-inline">
              <button type="button" class="btn-outline-sm" id="tipEditOpen">수정</button>
              <form method="POST" action="/tips/<%= tip.id %>/delete">
                <button type="button" class="btn-outline-sm" data-open-delete-confirm>삭제</button>
              </form>
            </div>
          <% } %>
        </div>

        <span class="detail-meta"><%= tip.author %> · <%= tip.date %> · 조회 <%= tip.views || 0 %></span>
      </div>

      <div class="detail-body"><%= tip.content %></div>

    </section>

    <section class="comments-section">
      <h3 class="comments-title">댓글 <%= tip.comments.length %>개</h3>

      <div class="comment-list">
        <% tip.comments.forEach(c => { %>
          <div class="comment-item">
            <div class="comment-head">
              <span class="comment-author"><%= c.author %></span>
              <span class="comment-date"><%= c.date %></span>
            </div>
            <p class="comment-text"><%= c.content %></p>
          </div>
        <% }) %>
      </div>

      <% if (currentUser) { %>
        <!-- TODO(API 연동): POST /api/tips/:id/comments 로 교체 -->
        <form action="/tips/<%= tip.id %>/comments" method="POST" class="comment-form">
          <input type="text" name="content" placeholder="댓글을 입력해주세요" required />
          <button type="submit" class="btn-comment-submit">등록</button>
        </form>
      <% } else { %>
        <p class="comment-login-hint">댓글을 작성하려면 <a href="/login">로그인</a>이 필요해요.</p>
      <% } %>
    </section>
  </main>
</div>

<!-- 글 수정 모달 -->
<% if (currentUser) { %>
  <div class="tip-write-overlay" id="tipEditOverlay" hidden>
    <div class="tip-write-modal">
      <div class="tip-write-head">
        <h3>글 수정</h3>
        <button type="button" class="tip-write-close" id="tipEditClose" aria-label="닫기">✕</button>
      </div>
      <!-- TODO(API 연동): PATCH /api/tips/:id 로 교체 -->
      <form action="/tips/<%= tip.id %>/edit" method="POST" id="tip-edit-form" class="form-stack">
        <label class="tip-write-label member-new-label-first">항목 선택</label>
        <div class="custom-select" id="tipEditCategorySelect">
          <button type="button" class="custom-select-trigger has-value" id="tipEditCategoryTrigger">
            <span id="tipEditCategoryTriggerText"><%= tip.category %></span>
            <span class="custom-select-arrow">⌄</span>
          </button>
          <div class="custom-select-options" id="tipEditCategoryOptions" hidden>
            <% Object.keys(catColor).forEach(cat => { %>
              <div class="custom-select-option" data-value="<%= cat %>">
                <span class="notice-list-badge" style="background-color:<%= catColor[cat] %>"><%= cat %></span>
                <span><%= cat %></span>
              </div>
            <% }) %>
          </div>
          <input type="hidden" name="category" id="tipEditCategoryValue" value="<%= tip.category %>" required />
        </div>

        <label class="tip-write-label">제목</label>
        <input type="text" name="title" value="<%= tip.title %>" required />

        <label class="tip-write-label">내용</label>
        <textarea name="content" rows="6" id="tipEditContent" required><%= tip.content %></textarea>
        <span class="tip-write-counter"><span id="tipEditCount"><%= tip.content.length %></span> / 3,000</span>

        <div class="tip-write-actions">
          <button type="button" class="btn-outline" id="tipEditCancel">취소</button>
          <button type="submit" class="btn-primary">저장하기</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 글자수 초과 알림 모달 -->
  <div class="alert-modal-overlay" id="tipEditLengthAlertOverlay" hidden>
    <div class="alert-modal">
      <img src="/images/stuate.png" alt="" class="alert-modal-icon" />
      <h3 class="alert-modal-title">너무 많은 글을 적었어!!</h3>
      <p class="alert-modal-sub">조금만 적게 써볼까?</p>
      <button type="button" class="alert-modal-confirm" id="tipEditLengthAlertConfirm">확인</button>
    </div>
  </div>
<% } %>

<!-- 삭제 확인 모달 -->
<div class="confirm-delete-overlay" id="deleteConfirmOverlay" hidden>
  <div class="confirm-delete-modal">
    <img src="/images/monster.png" alt="" class="confirm-delete-icon" />
    <h3 class="confirm-delete-title">정말 삭제하시겠어요?</h3>
    <p class="confirm-delete-sub">삭제한 글은 복구할 수 없어요.</p>
    <div class="confirm-delete-actions">
      <button type="button" class="confirm-delete-cancel" id="deleteConfirmCancel">취소</button>
      <button type="button" class="confirm-delete-submit" id="deleteConfirmSubmit">삭제</button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
