<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <a href="/" class="back-link">← 홈으로</a>

    <div class="page-head-row">
      <h2 class="page-title">자랑스런 요아정 멤버(<%= members.length %>명)</h2>
      <% if (currentUser) { %>
        <a href="/members/new" class="btn-dark btn-sm">새 멤버 등록</a>
      <% } %>
    </div>

    <section class="member-list">
      <% members.forEach((m, i) => { %>
        <a href="/members/<%= m.id %>" class="member-list-row">
          <div class="member-list-avatar palette-<%= (i % 8) + 1 %>" style="background-image:url('<%= m.avatar %>')"></div>
          <div class="member-list-info">
            <span class="member-list-name"><%= m.nickname %></span>
            <div class="member-list-badges">
              <span class="member-badge member-badge-role"><%= m.role %></span>
              <span class="member-badge member-badge-job"><%= m.job %></span>
            </div>
          </div>
          <span class="member-list-intro"><%= m.intro %></span>
        </a>
      <% }) %>
    </section>
  </main>
</div>

<%- include('partials/footer') %>
