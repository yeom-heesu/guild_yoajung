<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <div class="back-links">
      <a href="/notice" class="back-link">← 목록으로</a>
    </div>

    <%
      const noticeCatColor = {
        "공지": "#f7c9d8",
        "알림": "#a9d4f0",
        "이벤트": "#f5deA0",
        "추첨결과": "#b7e4c7",
      };
    %>

    <section class="panel detail-panel">
      <!-- TODO(API 연동): GET /api/notices/:id 결과로 교체 -->
      <div class="detail-head">
        <span class="notice-list-badge" style="background-color:<%= noticeCatColor[notice.category] || noticeCatColor['공지'] %>"><%= notice.category %></span>

        <div class="detail-title-row">
          <h2 class="detail-title"><%= notice.title %></h2>
          <% if (currentUser) { %>
            <div class="detail-actions-inline">
              <button type="button" class="btn-outline-sm" id="noticeEditOpen">수정</button>
              <form method="POST" action="/notice/<%= notice.id %>/delete">
                <button type="submit" class="btn-outline-sm">삭제</button>
              </form>
            </div>
          <% } %>
        </div>

        <span class="detail-meta"><%= notice.author %> · <%= notice.date %> · 조회 <%= notice.views || 0 %></span>
      </div>

      <div class="detail-body"><%= notice.content %></div>

    </section>

    <section class="comments-section">
      <h3 class="comments-title">댓글 <%= notice.comments.length %>개</h3>

      <div class="comment-list">
        <% notice.comments.forEach(c => { %>
          <div class="comment-item">
            <div class="comment-head">
              <span class="comment-author"><%= c.author %></span>
              <span class="comment-date"><%= c.date %></span>
            </div>
            <p class="comment-text"><%= c.content %></p>
          </div>
        <% }) %>
      </div>

      <% if (currentUser) { %>
        <!-- TODO(API 연동): POST /api/notices/:id/comments 로 교체 -->
        <form action="/notice/<%= notice.id %>/comments" method="POST" class="comment-form">
          <input type="text" name="content" placeholder="댓글을 입력해주세요" required />
          <button type="submit" class="btn-comment-submit">등록</button>
        </form>
      <% } else { %>
        <p class="comment-login-hint">댓글을 작성하려면 <a href="/login">로그인</a>이 필요해요.</p>
      <% } %>
    </section>
  </main>
</div>

<!-- 글 수정 모달 -->
<% if (currentUser) { %>
  <div class="tip-write-overlay" id="noticeEditOverlay" hidden>
    <div class="tip-write-modal">
      <div class="tip-write-head">
        <h3>글 수정</h3>
        <button type="button" class="tip-write-close" id="noticeEditClose" aria-label="닫기">✕</button>
      </div>
      <!-- TODO(API 연동): PATCH /api/notices/:id 로 교체 -->
      <form action="/notice/<%= notice.id %>/edit" method="POST" id="notice-edit-form" class="form-stack">
        <label class="tip-write-label member-new-label-first">항목 선택</label>
        <div class="custom-select" id="noticeEditCategorySelect">
          <button type="button" class="custom-select-trigger has-value" id="noticeEditCategoryTrigger">
            <span id="noticeEditCategoryTriggerText"><%= notice.category %></span>
            <span class="custom-select-arrow">⌄</span>
          </button>
          <div class="custom-select-options" id="noticeEditCategoryOptions" hidden>
            <% Object.keys(noticeCatColor).forEach(cat => { %>
              <div class="custom-select-option" data-value="<%= cat %>">
                <span class="notice-list-badge" style="background-color:<%= noticeCatColor[cat] %>"><%= cat %></span>
                <span><%= cat %></span>
              </div>
            <% }) %>
          </div>
          <input type="hidden" name="category" id="noticeEditCategoryValue" value="<%= notice.category %>" required />
        </div>

        <label class="tip-write-label">제목</label>
        <input type="text" name="title" value="<%= notice.title %>" required />

        <label class="tip-write-label">내용</label>
        <textarea name="content" rows="6" maxlength="3000" id="noticeEditContent" required><%= notice.content %></textarea>
        <span class="tip-write-counter"><span id="noticeEditCount"><%= notice.content.length %></span> / 3,000</span>

        <div class="tip-write-actions">
          <button type="button" class="btn-outline" id="noticeEditCancel">취소</button>
          <button type="submit" class="btn-primary">저장하기</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
