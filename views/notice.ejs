<%- include('partials/header') %>

<div class="layout">
  <%- include('partials/nav') %>

  <main class="content">
    <a href="/" class="back-link">← 홈으로</a>

    <div class="page-head-row">
      <h2 class="page-title">공지사항</h2>
      <% if (isAdmin) { %>
        <button type="button" class="btn-dark btn-sm" id="noticeWriteOpen">등록</button>
      <% } %>
    </div>

    <%
      const noticeCatColor = {
        "공지": "#f7c9d8",
        "알림": "#a9d4f0",
        "이벤트": "#f5deA0",
        "추첨결과": "#b7e4c7",
      };
      const noticeCategories = Object.keys(noticeCatColor);
    %>

    <% if (isAdmin) { %>
      <!-- TODO(API 연동): POST /api/notices 로 교체 -->
      <div class="tip-write-overlay" id="noticeWriteOverlay" hidden>
        <div class="tip-write-modal">
          <div class="tip-write-head">
            <h3>공지사항 등록</h3>
            <button type="button" class="tip-write-close" id="noticeWriteClose" aria-label="닫기">✕</button>
          </div>
          <form action="/notice" method="POST" id="notice-write-form" class="form-stack">
            <label class="tip-write-label">항목 선택</label>
            <div class="custom-select" id="noticeCategorySelect">
              <button type="button" class="custom-select-trigger" id="noticeCategoryTrigger">
                <span id="noticeCategoryTriggerText">카테고리를 선택해주세요</span>
                <span class="custom-select-arrow">⌄</span>
              </button>
              <div class="custom-select-options" id="noticeCategoryOptions" hidden>
                <% noticeCategories.forEach(cat => { %>
                  <div class="custom-select-option" data-value="<%= cat %>">
                    <span class="notice-list-badge" style="background-color:<%= noticeCatColor[cat] %>"><%= cat %></span>
                    <span><%= cat %> 등록</span>
                  </div>
                <% }) %>
              </div>
              <input type="hidden" name="category" id="noticeCategoryValue" required />
            </div>

            <label class="tip-write-label">제목</label>
            <input type="text" name="title" placeholder="제목을 입력해주세요" required />

            <label class="tip-write-label">내용</label>
            <textarea name="content" placeholder="내용을 입력해주세요" rows="6" maxlength="3000" id="noticeWriteContent" required></textarea>
            <span class="tip-write-counter"><span id="noticeWriteCount">0</span> / 3,000</span>

            <div class="tip-write-actions">
              <button type="button" class="btn-outline" id="noticeWriteCancel">취소</button>
              <button type="submit" class="btn-primary">등록</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>

    <section class="notice-list">
      <!-- TODO(API 연동): GET /api/notices 결과로 교체 -->
      <% notices.forEach(n => { %>
        <a href="/notice/<%= n.id %>" class="notice-list-row <%= n.pinned ? 'pinned' : '' %>">
          <span class="notice-list-badge" style="background-color:<%= noticeCatColor[n.category] || noticeCatColor['공지'] %>"><%= n.category %></span>
          <span class="notice-list-title"><%= n.title %></span>
          <span class="notice-list-meta"><%= n.author %> <%= n.date %></span>
        </a>
      <% }) %>
    </section>
  </main>
</div>

<%- include('partials/footer') %>
