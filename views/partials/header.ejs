<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>요아정 길드 | <%= typeof pageTitle !== "undefined" ? pageTitle : "홈" %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="<%= currentPath === '/' ? 'page-home' : '' %>">
  <div class="app">
    <!-- 상단 바 -->
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <span class="brand-emblem">🍫</span>
          <span class="brand-text">요아정 길드</span>
        </a>

        <!-- 데스크탑 전용 GNB (피그마 상단 탭) -->
        <nav class="topnav-gnb">
          <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">홈</a>
          <a href="/#section-members" class="<%= currentPath.startsWith('/members') ? 'active' : '' %>">멤버소개</a>
          <a href="/#section-notice" class="<%= currentPath.startsWith('/notice') ? 'active' : '' %>">공지사항</a>
          <a href="/#section-tips" class="<%= currentPath.startsWith('/tips') ? 'active' : '' %>">팁 &amp; 공략</a>
          <a href="/#section-photos" class="<%= currentPath.startsWith('/photos') ? 'active' : '' %>">스크린샷</a>
        </nav>

        <div class="topbar-right">
          <div class="topbar-auth">
            <% if (!currentUser) { %>
              <!-- TODO(기획 외 추가): 가입 문의 - 실제로는 디스코드 초대 링크나 신청 폼으로 교체 -->
              <a href="mailto:guild.yoajeong@example.com" class="btn-join-inquiry">가입 문의</a>
            <% } %>
            <% if (currentUser) { %>
              <span class="topbar-user-name">
                <img src="<%= currentUser.avatar %>" alt="" class="topbar-user-avatar" />
                <%= currentUser.nickname %>님
              </span>
              <% if (isAdmin) { %>
                <a href="/admin/users/new" class="btn-ghost-sm">사용자 등록</a>
              <% } %>
              <form action="/logout" method="POST" class="inline-form">
                <button type="submit" class="btn-ghost-sm">로그아웃</button>
              </form>
            <% } else { %>
              <a href="/login" class="btn-ghost-sm">로그인</a>
            <% } %>
          </div>

          <% if (currentUser) { %>
            <img src="<%= currentUser.avatar %>" alt="" class="topbar-mobile-avatar" />
          <% } %>

          <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="메뉴 열기" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- 모바일 전용 메뉴 패널 -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay" hidden>
      <div class="mobile-menu-panel">
        <div class="mobile-menu-head">
          <a href="/" class="brand">
            <span class="brand-emblem"></span>
            <span class="brand-text">요아정 길드</span>
          </a>
          <button type="button" class="mobile-menu-close" id="mobileMenuClose" aria-label="메뉴 닫기">✕</button>
        </div>

        <nav class="mobile-menu-nav">
          <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">홈</a>
          <a href="/#section-members" class="<%= currentPath.startsWith('/members') ? 'active' : '' %>">멤버소개</a>
          <a href="/#section-notice" class="<%= currentPath.startsWith('/notice') ? 'active' : '' %>">공지사항</a>
          <a href="/#section-tips" class="<%= currentPath.startsWith('/tips') ? 'active' : '' %>">팁 &amp; 공략</a>
          <a href="/#section-photos" class="<%= currentPath.startsWith('/photos') ? 'active' : '' %>">스크린샷</a>
        </nav>

        <% if (!currentUser) { %>
          <div class="mobile-menu-auth">
            <a href="/login" class="btn-ghost-sm">로그인</a>
            <a href="mailto:guild.yoajeong@example.com" class="btn-join-inquiry">가입 문의</a>
          </div>
        <% } else if (isAdmin) { %>
          <div class="mobile-menu-auth">
            <a href="/admin/users/new" class="btn-ghost-sm">사용자 등록</a>
          </div>
        <% } %>
      </div>
    </div>
